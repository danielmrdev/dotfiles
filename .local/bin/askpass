#!/usr/bin/env bash
# SUDO_ASKPASS helper — bemenu popup on Wayland (Hyprland)
set -euo pipefail

# Read Omarchy theme colors
THEME_FILE="$HOME/.config/omarchy/current/theme/colors.toml"
BG=$(grep -m1 '^background\s*=' "$THEME_FILE" 2>/dev/null | sed 's/.*"//;s/".*//') || BG="#dfe4c4"
FG=$(grep -m1 '^foreground\s*=' "$THEME_FILE" 2>/dev/null | sed 's/.*"//;s/".*//') || FG="#1c2d28"
AC=$(grep -m1 '^accent\s*=' "$THEME_FILE" 2>/dev/null | sed 's/.*"//;s/".*//') || AC="#5e81ac"
C7=$(grep -m1 '^color7\s*=' "$THEME_FILE" 2>/dev/null | sed 's/.*"//;s/".*//') || C7="#384f54"

PROMPT="[sudo] password for ${USER}:"

# Get the command sudo is running
CMD=""
parent_pid=$PPID
while [[ $parent_pid -gt 1 ]]; do
  CMDLINE=$(tr '\0' ' ' < "/proc/$parent_pid/cmdline" 2>/dev/null || true)
  if echo "$CMDLINE" | grep -q '^sudo '; then
    # Strip "sudo -A " prefix for display
    CMD=$(echo "$CMDLINE" | sed 's/^sudo -A //;s/^sudo //')
    break
  fi
  parent_pid=$(awk '{print $4}' "/proc/$parent_pid/stat" 2>/dev/null) || break
done

if [[ -n "$CMD" ]]; then
  PROMPT="[sudo] $CMD"
fi

# Show bemenu password prompt
bemenu \
  --password indicator \
  --prompt "$PROMPT" \
  --tb "$BG" --tf "$FG" \
  --fb "$BG" --ff "$FG" \
  --nb "$BG" --nf "$FG" \
  --hb "$AC" --hf "$BG" \
  --fbb "$C7" --fbf "$FG" \
  --fn "monospace 14" \
  --center \
  --line-height 24 \
  --scrollbar none \
  --no-spacing \
  --grab \
  --width-factor 0.35 \
  < /dev/null
