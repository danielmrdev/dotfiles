#!/usr/bin/env python3
"""SUDO_ASKPASS helper — GTK dialog styled like Omarchy modals."""

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk, Pango
import os, re, sys

# ── Read active Omarchy v4 theme ───────────────────────────────────
# v4 keeps the applied theme in XDG state and puts surface-specific colors
# (including Polkit) in shell.toml. Keep the old config path as a fallback.
THEME_DIRS = (
    os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                 "omarchy", "current", "theme"),
    os.path.expanduser("~/.config/omarchy/current/theme"),
)


def read_theme_file(path):
    values = {}
    section = ""
    try:
        with open(path) as f:
            lines = f.readlines()
    except OSError:
        return values

    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        section_match = re.match(r"^\[([A-Za-z0-9_-]+)\]$", line)
        if section_match:
            section = section_match.group(1).lower()
            continue
        match = re.match(r"^([A-Za-z0-9_-]+)\s*=\s*(.+)$", line)
        if not match:
            continue
        key, value = match.groups()
        value = value.strip()
        if value.startswith(('\"', "'")) and value.endswith(value[0]):
            value = value[1:-1]
        else:
            value = value.split(" #", 1)[0].strip()
        values[f"{section}.{key.lower()}" if section else key.lower()] = value
    return values


def resolve_color(value, colors, surfaces, fallback, seen=None):
    """Resolve hex colors and Omarchy surface references to GTK colors."""
    if not value:
        return fallback
    text = str(value)
    match = re.search(r"#[0-9A-Fa-f]{6}", text)
    if match:
        return match.group(0)
    match = re.search(r"rgba?\(\s*([0-9A-Fa-f]{6})[0-9A-Fa-f]{0,2}", text)
    if match:
        return "#" + match.group(1)

    key = text.strip().lower()
    seen = seen or set()
    if key in seen:
        return fallback
    seen.add(key)
    if key in surfaces:
        return resolve_color(surfaces[key], colors, surfaces, fallback, seen)
    if key in colors:
        return resolve_color(colors[key], colors, surfaces, fallback, seen)
    return fallback


def rgba(hex_color, alpha):
    red, green, blue = (int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    return f"rgba({red}, {green}, {blue}, {max(0.0, min(1.0, alpha)):.3f})"


def read_colors():
    defaults = {
        "background": "#dfe4c4",
        "foreground": "#1c2d28",
        "accent": "#5e81ac",
        "border": "#384f54",
    }
    theme_dir = next((path for path in THEME_DIRS
                      if os.path.isfile(os.path.join(path, "colors.toml"))), None)
    if not theme_dir:
        return (defaults["background"], defaults["foreground"],
                defaults["accent"], defaults["border"])

    colors = read_theme_file(os.path.join(theme_dir, "colors.toml"))
    surfaces = read_theme_file(os.path.join(theme_dir, "shell.toml"))
    base_bg = resolve_color(colors.get("background"), colors, surfaces,
                            defaults["background"])
    base_fg = resolve_color(colors.get("foreground"), colors, surfaces,
                            defaults["foreground"])
    base_accent = resolve_color(colors.get("accent"), colors, surfaces,
                                defaults["accent"])
    base_border = resolve_color(colors.get("color7"), colors, surfaces,
                                defaults["border"])
    bg_hex = resolve_color(surfaces.get("polkit.background"), colors, surfaces,
                           base_bg)
    fg_hex = resolve_color(surfaces.get("polkit.text"), colors, surfaces,
                           base_fg)
    accent = resolve_color(surfaces.get("polkit.accent"), colors, surfaces,
                           base_accent)
    border = resolve_color(surfaces.get("polkit.border"), colors, surfaces,
                           base_border)
    try:
        bg_alpha = float(surfaces.get("polkit.background-alpha", "1"))
    except ValueError:
        bg_alpha = 1.0
    return rgba(bg_hex, bg_alpha), fg_hex, accent, border


BG, FG, ACCENT, BORDER = read_colors()
user = os.environ.get("USER", "")

# ── Get the command that triggered sudo ─────────────────────────
def get_sudo_command():
    """Read parent (sudo) cmdline to find what command is being run."""
    try:
        ppid = os.getppid()
        with open(f"/proc/{ppid}/cmdline", "rb") as f:
            raw = f.read()
        parts = raw.replace(b"\x00", b" ").decode("utf-8", errors="replace").strip().split()
        # parts = e.g. ["sudo", "-A", "pacman", "-S", "foo"]
        # Strip leading "sudo" and "-A" only
        if parts and parts[0] == "sudo":
            parts.pop(0)
        if parts and parts[0] == "-A":
            parts.pop(0)
        return " ".join(parts) if parts else ""
    except Exception:
        return ""

command = get_sudo_command()
# Env overrides (defaults keep sudo behavior identical). Used e.g. by
# ops/lib/bw.sh to prompt for the Bitwarden master password.
title = os.environ.get("ASKPASS_TITLE", "sudo")
label_text = os.environ.get("ASKPASS_LABEL", f"[sudo] password for {user}:")
display_command = os.environ.get("ASKPASS_COMMAND") or command or "sudo"

# ── CSS ────────────────────────────────────────────────────────────
css = f"""
window {{
  background: {BG};
}}
.dialog-box {{
  background: transparent;
  padding: 22px 26px;
  min-width: 360px;
}}
label.prompt {{
  color: {FG};
  font-weight: bold;
  font-size: 14px;
  margin-bottom: 4px;
}}
label.command {{
  color: {BORDER};
  font-family: monospace;
  font-size: 12px;
  margin-bottom: 12px;
}}
entry {{
  background: {BG};
  color: {FG};
  border: 1px solid {BORDER};
  border-radius: 4px;
  padding: 8px 12px;
  font-size: 15px;
  caret-color: {ACCENT};
}}
entry:focus {{
  border-color: {ACCENT};
  box-shadow: 0 0 0 1px {ACCENT}44;
}}
"""

class AskPassWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=title)
        self.set_decorated(False)
        self.set_resizable(False)
        # GTK3 on Wayland: without an explicit size the compositor sizes the window to
        # the full monitor. Force a compact dialog.
        self.set_default_size(420, 200)
        self.set_size_request(420, 200)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)
        self.set_urgency_hint(True)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        vbox.set_valign(Gtk.Align.CENTER)
        vbox.set_halign(Gtk.Align.CENTER)
        self.add(vbox)

        dialog = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        dialog.get_style_context().add_class("dialog-box")
        vbox.pack_start(dialog, False, False, 0)

        lbl = Gtk.Label(label=label_text)
        lbl.get_style_context().add_class("prompt")
        lbl.set_xalign(0)
        dialog.pack_start(lbl, False, False, 0)

        # Always render a bounded command line. GTK ellipsize alone does not
        # constrain a label's requested width, which makes long sudo commands
        # stretch the dialog across the monitor.
        cmd_text = display_command
        if len(cmd_text) > 108:
            cmd_text = cmd_text[:107] + "…"

        cmd_lbl = Gtk.Label(label=cmd_text)
        cmd_lbl.get_style_context().add_class("command")
        cmd_lbl.set_xalign(0)
        cmd_lbl.set_line_wrap(True)
        cmd_lbl.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        cmd_lbl.set_max_width_chars(55)
        dialog.pack_start(cmd_lbl, False, False, 0)

        self.entry = Gtk.Entry()
        self.entry.set_visibility(False)
        self.entry.set_invisible_char("●")
        self.entry.connect("activate", self.on_submit)
        self.entry.connect("key_press_event", self.on_key)
        dialog.pack_start(self.entry, False, False, 0)

        self.show_all()
        self.entry.grab_focus()

    def on_submit(self, *_args):
        pwd = self.entry.get_text()
        sys.stdout.write(pwd + "\n")
        sys.stdout.flush()
        Gtk.main_quit()

    def on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
        return False

if __name__ == "__main__":
    win = AskPassWindow()
    Gtk.main()
