#!/usr/bin/env bash
set -e

gtk2_lib="$HOME/.local/opt/tizen-gtk2/usr/lib"
export LD_LIBRARY_PATH="$gtk2_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GTK_PATH="$gtk2_lib/gtk-2.0${GTK_PATH:+:$GTK_PATH}"
export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:+$JAVA_TOOL_OPTIONS }-Dswt.autoScale=150"

exec "$HOME/tizen-studio/ide/TizenStudio.sh" "$@"
