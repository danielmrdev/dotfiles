#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/teams-jiggler"
MODE_FILE="$CONFIG_DIR/mode"
START="07:54"
END="15:18"
MIN_INTERVAL_SECONDS=35
MAX_INTERVAL_SECONDS=65

mkdir -p "$CONFIG_DIR"
[[ -f "$MODE_FILE" ]] || printf 'schedule\n' > "$MODE_FILE"

within_schedule() {
  local day time
  day=$(date +%u)      # 1=Mon .. 7=Sun
  time=$(date +%H:%M)
  [[ "$day" -ge 1 && "$day" -le 5 && "$time" > "$START" && "$time" < "$END" ]]
}

rand_between() {
  local min=$1 max=$2
  echo $((RANDOM % (max - min + 1) + min))
}

jiggle() {
  # Send a harmless F24 key event via wtype (virtual-keyboard protocol).
  # Hyprland treats this as real input and resets the idle timer.
  # F24 is unused by any application, so no visible side effects.
  wtype -k f24 >/dev/null 2>&1 || return 1
}

while true; do
  mode=$(cat "$MODE_FILE" 2>/dev/null || printf 'off')
  case "$mode" in
    infinite)
      jiggle || true
      ;;
    schedule)
      if within_schedule; then
        jiggle || true
      fi
      ;;
    off|*)
      ;;
  esac
  sleep "$(rand_between "$MIN_INTERVAL_SECONDS" "$MAX_INTERVAL_SECONDS")"
done
