#!/bin/bash
# post-update hook: verify dotfiles configs are intact after omarchy update
# Runs automatically after every `omarchy update`

set -uo pipefail

LOG=/tmp/omarchy-post-update.log
exec > "$LOG" 2>&1

notify() {
    local msg="$1"
    local urgency="${2:-normal}"
    if command -v notify-send &>/dev/null && [ -n "${DISPLAY:-}" ]; then
        notify-send -a "omarchy" -u "$urgency" -t 8000 "Post-update: $msg"
    fi
    echo "[$urgency] $msg"
}

errors=()
warnings=()

# ── 1. Symlinks intact ──────────────────────────────────────────
DOTFILES_CHECKLIST=(
    ".config/hypr/bindings.conf"
    ".config/hypr/monitors.conf"
    ".config/hypr/autostart.conf"
    ".config/hypr/workspaces.conf"
    ".config/waybar/config.jsonc"
    ".config/waybar/style.css"
    ".config/walker/config.toml"
)

for relpath in "${DOTFILES_CHECKLIST[@]}"; do
    target="$HOME/$relpath"
    dotfile="$HOME/.dotfiles/$relpath"
    if [ -L "$target" ]; then
        link_target=$(readlink "$target")
        if [ "$link_target" != "$dotfile" ]; then
            warnings+=("$relpath → symlink points to $link_target, not $dotfile")
        fi
    elif [ -f "$target" ]; then
        if cmp -s "$target" "$dotfile" 2>/dev/null; then
            warnings+=("$relpath is a regular file (not symlinked) — run restore.sh")
        else
            errors+=("$relpath is a regular file with different content — run restore.sh")
        fi
    else
        errors+=("$relpath missing")
    fi
done

# ── 2. Hyprland config errors ───────────────────────────────────
if command -v hyprctl &>/dev/null; then
    error_count=$(hyprctl configerrors 2>/dev/null | grep -c "Config error" || true)
    if [ "$error_count" -gt 0 ]; then
        warnings+=("$error_count hyprland config errors — check 'hyprctl configerrors'")
    fi

    # ── 3. Plugins loaded ──────────────────────────────────────
    plugin_count=$(hyprctl plugin list 2>/dev/null | grep -c "^Plugin" || true)
    if [ "$plugin_count" -eq 0 ]; then
        warnings+=("No hyprland plugins loaded — check exec-once in config")
    fi
fi

# ── Report ──────────────────────────────────────────────────────
if [ ${#errors[@]} -gt 0 ]; then
    for e in "${errors[@]}"; do notify "ERROR: $e" "critical"; done
    notify "${#errors[@]} error(s)" "critical"
elif [ ${#warnings[@]} -gt 0 ]; then
    for w in "${warnings[@]}"; do notify "WARN: $w" "normal"; done
    notify "${#warnings[@]} warning(s)" "normal"
else
    notify "All checks passed ✓" "low"
fi
