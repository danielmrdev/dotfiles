#!/bin/bash
# post-update hook: verify configs are intact after omarchy update
# Runs automatically after every `omarchy update`
# Updated for Omarchy v4 (2026-08): hypr .conf -> .lua, waybar/walker retired,
# no plugins by default (hy3 dropped).

set -uo pipefail

LOG=/tmp/omarchy-post-update.log
exec > "$LOG" 2>&1

notify() {
    local msg="$1"
    local urgency="${2:-normal}"
    if command -v notify-send &>/dev/null && [ -n "${DISPLAY:-}" ]; then
        notify-send -a "omarchy" -u "$urgency" -t 8000 "Post-update: $msg"
    fi
    echo "[$urgency] $msg"
}

errors=()
warnings=()

# ── 1. v4 Hyprland lua configs present ─────────────────────────
V4_CHECKLIST=(
    ".config/hypr/hyprland.lua"
    ".config/hypr/monitors.lua"
    ".config/hypr/input.lua"
    ".config/hypr/bindings.lua"
    ".config/hypr/looknfeel.lua"
    ".config/hypr/autostart.lua"
)

for relpath in "${V4_CHECKLIST[@]}"; do
    if [ ! -f "$HOME/$relpath" ]; then
        errors+=("$relpath missing")
    fi
done

# ── 2. Hyprland config errors ───────────────────────────────────
if command -v hyprctl &>/dev/null; then
    error_count=$(hyprctl configerrors 2>/dev/null | grep -vcE '^\s*$' || true)
    if [ "$error_count" -gt 0 ]; then
        warnings+=("$error_count hyprland config errors — check 'hyprctl configerrors'")
    fi
fi

# ── Report ──────────────────────────────────────────────────────
if [ ${#errors[@]} -gt 0 ]; then
    for e in "${errors[@]}"; do notify "ERROR: $e" "critical"; done
    notify "${#errors[@]} error(s)" "critical"
elif [ ${#warnings[@]} -gt 0 ]; then
    for w in "${warnings[@]}"; do notify "WARN: $w" "normal"; done
    notify "${#warnings[@]} warning(s)" "normal"
else
    notify "All checks passed ✓" "low"
fi
